# SpendWise AI - production environment template (reference).
# Copy to .env.production and fill in real values. Never commit that file.
# .gitignore excludes .env.* except .env.example.

# Required. Must be staging or production for a real deployment.
APP_ENV=production

# Required. Full PostgreSQL DSN for your managed database, e.g.
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Startup fails if this is left empty or is still a placeholder.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Optional. Only set if a browser client calls the API directly.
# Streamlit calls the API server-side, so this is normally empty.
# Explicit origins only; wildcards are rejected at startup.
CORS_ALLOW_ORIGINS=

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
