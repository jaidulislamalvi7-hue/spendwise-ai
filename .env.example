# SpendWise AI - environment template. Copy to .env and fill in real values.
# Never commit a real .env file (.gitignore already excludes it).

# --- Core -------------------------------------------------------------------
# Environment name: development | staging | production
APP_ENV=development

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string, using the psycopg 3 driver.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
#
# Local PostgreSQL 18 defaults used by this project:
#   host     localhost
#   port     5432
#   database spendwise_db
#   user     postgres
#
# Replace the CHANGE_ME placeholder with the password you set for the
# "postgres" user during installation. Never commit the real value.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/spendwise_db

# --- Authentication ---------------------------------------------------------
# Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required whenever APP_ENV is not "development"; startup fails without it.
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Frontend ---------------------------------------------------------------
# Base URL of the FastAPI backend as reached from the Streamlit server.
# In Docker Compose this must be the service name, e.g. http://backend:8000
BACKEND_API_URL=http://localhost:8000

# --- Cross-origin (optional) ------------------------------------------------
# Leave blank unless a browser client calls the API directly. Streamlit calls
# the API server-side, so CORS stays disabled with an empty value, which is the
# safe default. If you do need it, list explicit origins separated by commas:
#   CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
# Wildcards are rejected at startup.
CORS_ALLOW_ORIGINS=

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Docker Compose only (local development database) -----------------------
# Used by docker-compose.yml, not by the application itself.
POSTGRES_USER=spendwise
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
POSTGRES_DB=spendwise_db
